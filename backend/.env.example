# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=Student AI Platform
DEBUG=false
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/student_ai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/student_ai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_data

# ─── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RESUMES=resumes
MINIO_SECURE=false

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key...
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...
IBM_API_KEY=...your-ibm-watsonx-api-key...
IBM_PROJECT_ID=...your-ibm-project-id...
IBM_URL=https://us-south.ml.cloud.ibm.com

# ─── LangSmith Observability ──────────────────────────────────────────────────
LANGCHAIN_API_KEY=ls__...your-langsmith-key...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=student-ai-platform

# ─── Token Budget ─────────────────────────────────────────────────────────────
DAILY_TOKEN_BUDGET_USD=0.50

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
